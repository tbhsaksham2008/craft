{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "craft-smp-store",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "no_bundle": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
